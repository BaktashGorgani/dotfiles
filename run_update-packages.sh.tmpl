#!/bin/bash
# vim: filetype=sh

# Run package updates on every chezmoi apply, including when invoked through
# chezmoi update --refresh-externals (the `cur` alias).

# See run_onchange_install-packages.sh.tmpl for why these are set. Fail fast
# and report the failing line rather than printing "... updated!" regardless.
set -Eeuo pipefail
trap 'printf "\n!!! FAILED at line %s: %s\n" "$LINENO" "$BASH_COMMAND" >&2' ERR

function log() {
    # If stdout is a real terminal, ask it for the cursor's actual column via
    # a Cursor Position Report (CSI 6n) and only prepend a newline when the
    # cursor isn't already at column 1 (e.g. after nvim's headless output,
    # which doesn't end in a newline). `-t 0.2` + `|| true` keep this a no-op
    # (identical to the original behavior) if it's not a terminal or the
    # terminal doesn't answer in time, so this can never hang or trip `set -e`.
    if [[ -t 1 && -t 0 ]]; then
        local esc row col
        IFS='[;' read -s -d R -t 0.2 -p $'\e[6n' esc row col || true
        [[ -n "$col" && "$col" != "1" ]] && printf "\n"
    fi
    printf "%0.s*" {1..50}; printf "\n$1\n"; printf "%0.s*" {1..50};echo
}

# Make sure brew is on PATH even when this is run from a non-login shell.
function brew_shellenv() {
    local candidate
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
        if [[ -x "$candidate" ]]; then
            eval "$("$candidate" shellenv)"
            return 0
        fi
    done
    return 1
}

brew_shellenv || true

log "\nBEGIN UPDATE SCRIPT\n"

{{ if eq .chezmoi.os "linux" }}
    {{ if (and (eq .chezmoi.hostname "baky-fedora-pc" ) (eq .chezmoi.osRelease.id "fedora")) }}
        log "Updating dnf packages..."

        sudo dnf update -y

        log "Dnf packages updated!"

        log "Cleaning up dnf..."

        sudo dnf autoremove -y
        sudo dnf clean packages

        log "Dnf cleaned up!"

        log "Updating flatpak packages..."

        flatpak update -y

        log "Flatpak packages updated!"

        log "Cleaning up flatpak..."

        # Pins are never dropped automatically, even once the ref they name is
        # gone (flatpak/flatpak#5058), and a stale pin silently exempts that ref
        # from --unused and end-of-life cleanup. Prune pins with no matching
        # installed ref. Wildcard and partial patterns are deliberate, so keep
        # them.
        flatpak pin 2>/dev/null | sed -n 's/^[[:space:]]\+//p' | while read -r pattern; do
            case "$pattern" in
                *'*'*) continue ;;
                runtime/*/*/*) ;;
                *) continue ;;
            esac
            if ! flatpak list --columns=ref | grep -qx "${pattern#runtime/}"; then
                printf "\nRemoving stale pin %s...\n" "$pattern"
                sudo flatpak pin --remove "$pattern"
            fi
        done

        # `flatpak update` only offers this interactively, and we pass -y above.
        flatpak uninstall --unused -y --noninteractive

        log "Flatpak cleaned up!"
    {{ end }}
{{ end }}
log "Updating Homebrew packages..."

# -y: brew asks "Do you want to proceed with the upgrade?" and stdin is not a
# terminal here, so without it the run depends on how brew handles a closed
# prompt rather than on an explicit answer.
brew update
brew upgrade -y

log "Homebrew packages updated!"

log "Cleaning up Homebrew..."

# Drop formulae kept only as dependencies of something since uninstalled, then
# purge superseded versions and stale downloads.
brew autoremove
brew cleanup --prune=all

log "Homebrew cleaned up!"
{{ template "pipx-maintenance.sh" . }}

log "Repairing and updating pipx packages..."

maintain_pipx update {{ range .packages.pipxs }}{{ . | quote }} {{ end }}

log "Pipx packages updated and verified!"

log "Updating TPM Plugins..."

$HOME/.tmux/plugins/tpm/bin/update_plugins all

log "TPM plugins updated!"

# Deliberately no `tpm clean_plugins` here. tmux-nerd-font-window-name lives in
# ~/.tmux/plugins but is managed as a chezmoi external and invoked by path
# rather than declared with @plugin, so tpm treats it as foreign and deletes it.
# chezmoi would then restore it on the next apply, causing it to be churned on
# every update.

log "Updating Neovim plugins..."

# `Lazy! sync` is the blocking form (install + clean + update). Without the
# bang, lazy schedules the work asynchronously and --headless quits before it
# runs. Like nvim-treesitter, lazy never sets a non-zero exit code on
# failure, so scan every plugin's tasks for one that ended in error and
# `cquit` if any did, rather than silently printing "updated!" regardless.
nvim --headless "+Lazy! sync" -c "lua local failed = {}; for name, plugin in pairs(require('lazy.core.config').plugins) do for _, task in ipairs(plugin._.tasks or {}) do if task:has_errors() then table.insert(failed, name) end end end; if #failed > 0 then vim.api.nvim_err_writeln('Lazy sync failed for: ' .. table.concat(failed, ', ')); vim.cmd('cquit 1') end" -c "qa"

log "Neovim plugins updated!"

log "Checking Mason Jedi..."

# Embed the helper so this works before/without applying a separate helper file.
nvim --headless -c "$(cat <<'LUA'
lua {{ template "mason-jedi.lua" . }}
LUA
)" -c "qa"

log "Mason Jedi verified!"

log "Updating Treesitter parsers..."

# nvim-treesitter's `build = ":TSUpdate"` hook only reruns when lazy pulls a
# new nvim-treesitter commit, not when only a language parser has a new
# release, so parsers can go stale silently otherwise. Run it explicitly every
# time to keep them current.
#
# `:TSUpdateSync` no longer exists (removed by nvim-treesitter's v3 rewrite)
# and plain `:TSUpdate` only schedules the update asynchronously, so a
# headless `+TSUpdate +qa` would quit before it finishes. Call the async task
# directly and block on it with `:wait()` instead, same as above. `cquit` on
# error so a real failure trips `set -e` above rather than silently printing
# "updated!" regardless, like every other command in this script.
nvim --headless -c "lua local ok, err = pcall(function() require('nvim-treesitter.install').update(nil, { summary = true }):wait() end); if not ok then vim.api.nvim_err_writeln(tostring(err)); vim.cmd('cquit 1') end" -c "qa"

log "Treesitter parsers updated!"

log "Updating Rust..."

rustup update

log "Rust Updated"

log "Updating Rust packages..."

cargo install-update --locked --git --all

log "Rust packages updated!"

log "Cleaning up Rust..."

# Cargo never prunes the registry. --autoclean drops extracted sources but
# keeps the .crate archives, so rebuilds stay fast.
cargo cache --autoclean

log "Rust cleaned up!"

log "\nEND UPDATE SCRIPT\n"
