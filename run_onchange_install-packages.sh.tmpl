#!/bin/sh
# vim: filetype=sh
function log() {
    printf "%0.s*" {1..50}; printf "\n$1\n"; printf "%0.s*" {1..50};echo
}

log "\nBEGIN INSTALL SCRIPT\n"

{{ if eq .chezmoi.os "linux" }}
    {{ if (and (contains "WSL" .chezmoi.kernel.osrelease) (eq .chezmoi.osRelease.id "opensuse-tumbleweed")) }}
        log "Installing zypper packages..."

        ZYPPER_NON_INTERACTIVE="sudo zypper --non-interactive --gpg-auto-import-keys"
        $ZYPPER_NON_INTERACTIVE install {{ range .packages.wsl_opensuse_tumbleweed.zyppers }}{{ . | quote }} {{ end }}

        log "Zypper packages installed!"
    {{ else if (and (eq .chezmoi.hostname "baky-fedora-pc" ) (eq .chezmoi.osRelease.id "fedora")) }}
        log "Enabling required COPR repos..."

        sudo dnf copr enable -y sdegler/hyprland
        sudo dnf copr enable -y tofik/nwg-shell

        log "COPR repos enabled!"

        log "Installing dnf packages..."

        sudo dnf install -y {{ range .packages.fedora.home.dnfs }}{{ . | quote }} {{ end }}

        log "Dnf packages installed!"

        # This list must contain applications only. Explicitly installing a
        # runtime makes flatpak auto-pin it (see flatpak-pin(1)), and pins are
        # never cleaned up (flatpak/flatpak#5058), which permanently exempts the
        # ref from `--unused` and end-of-life cleanup. Runtimes, GL/VAAPI
        # extensions and themes are resolved as dependencies instead, with the
        # correct branch and no pin. --app makes a stray runtime a loud failure
        # rather than a silent new pin.
        log "Installing flatpak packages..."
        {{ range .packages.fedora.home.flatpaks }}
            # `flatpak info` errors out when an id has several branches installed,
            # which would make us try to reinstall an already-present ref, so
            # match against the installed list by application id instead.
            if ! flatpak list --app --columns=application | grep -qx {{ . | quote }}; then
                printf "\nInstalling {{ . }}...\n"
                # Name the remote explicitly; some ids (e.g. org.videolan.VLC)
                # exist on both `fedora` and `flathub` and would otherwise prompt.
                flatpak install -y --noninteractive --app flathub {{ . }}
            else
                printf "\n{{ . }} already installed!\n"
            fi
        {{ end }}
        echo
        log "Flatpak packages installed!"
    {{ end }}
{{ end }}
log "Checking for Homebrew..."

if hash brew &>/dev/null; then
    log "Homebrew already installed!"
else
    log "Homebrew not found, installing..."

    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    log "Homebrew installed!"
fi

log "Installing Homebrew packages..."
{{ range .packages.brews }}
    if ! brew list {{ . }} &> /dev/null; then
        printf "\nInstalling {{ . }}...\n"
        brew install {{ . }}
    else
        printf "\n{{ . }} already installed!\n"
    fi
{{ end }}
echo
log "Homebrew packages installed!"

log "Installing TPM plugins..."
{{ range .packages.tpms }}
    if [[ ! -d "$HOME/.tmux/plugins/{{ . }}" ]]; then
        printf "\nA plugin is missing. Attempting to reinstall all plugins...\n"
        $HOME/.tmux/plugins/tpm/bin/install_plugins
    else
        printf "\n{{ . }} already installed!!\n"
    fi
{{ end }}
log "TPM plugins installed!"

# rustup and cargo live in ~/.cargo/bin, which only reaches PATH via this env
# file. Source it up front so an existing toolchain is detected regardless of
# the PATH this script inherited, otherwise every run reports "Rust not found"
# and reinstalls rustup.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

log "Checking for Rust..."

if hash rustup &>/dev/null; then
    log "Rust already installed!!"
else
    log "Rust not found, installing..."

    # -y is required: the installer aborts with "Unable to run interactively"
    # when stdin is not a terminal, which is always the case here.
    # --no-modify-path because dot_zshenv and dot_bashrc already source
    # cargo's env, and anything rustup appends to those chezmoi-managed files
    # would be reverted on the next apply.
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path

    # rustup only edits shell rc files, so this process still needs cargo on
    # PATH before anything below can run.
    [ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

    log "Rust installed!"
fi

if ! hash cargo &>/dev/null; then
    log "ERROR: cargo unavailable after Rust setup; skipping Rust packages!"
else
    log "Installing Rust packages..."

    # --locked honours each crate's committed Cargo.lock; without it cargo
    # resolves to latest compatible deps, which breaks crates whose deps have
    # shipped semver-incompatible changes (e.g. eza -> palette/palette_derive).
    cargo install --locked {{ range .packages.crates }}{{ . | quote }} {{ end }}

    log "Rust packages installed!"

    log "Installing Rust packages from git..."
    {{ range .packages.git_crates }}
        if ! cargo install --list | grep -q "^{{ base . }} "; then
            printf "\nInstalling {{ . }}...\n"
            cargo install --locked --git {{ . | quote }}
        else
            printf "\n{{ base . }} already installed!\n"
        fi
    {{ end }}
    echo
    log "Rust git packages installed!"

    log "Installing Rust-Analyzer"

    rustup component add rust-analyzer

    log "Rust-Analyzer installed!"
fi

log "Checking for zoxide..."

if hash zoxide &>/dev/null; then
    log "Zoxide already installed!"
else
    log "Zoxide not found, installing..."

    curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh

    log "Zoxide installed!"
fi

log "\nEND INSTALL SCRIPT\n"
